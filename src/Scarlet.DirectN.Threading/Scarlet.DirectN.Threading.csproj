<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Scarlet.DirectN.Threading</PackageId>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <PackageTags>directn;win32;synchronizationcontext;dispatcher;threading;aot;nativeaot</PackageTags>
    <Description>UI-thread message queue and SynchronizationContext for DirectN (Win32) apps, Native AOT compatible. Used by Scarlet.Extensions.Hosting.DirectN; one queue per UI thread.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DirectNAot" />
    <InternalsVisibleTo Include="Scarlet.Extensions.Hosting.DirectN" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\MessageQueue.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

</Project>
