  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Test code: rules that only matter for shipped libraries. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scarlet.Extensions.Hosting.DirectN.TrayIcon\Scarlet.Extensions.Hosting.DirectN.TrayIcon.csproj" />
  </ItemGroup>

</Project>
